/*
 * U-Boot specific additions for the ONYX BOOX C67ML Magellan.
 *
 * Copyright (c) 2024, Mario Rugiero
 *
 * Pulls in the shared Rockchip binman image description and marks the
 * boot-essential nodes for the pre-relocation (SPL) phase.  The board DTS
 * already carries inline u-boot,dm-pre-reloc on uart2/emmc/sdmmc/i2c0; this
 * overlay adds the SoC infrastructure (cru, grf, oscillator) the early DM
 * needs before relocation.
 */

#include "rockchip-u-boot.dtsi"

&cru {
	bootph-all;
};

&grf {
	bootph-all;
};

&xin24m {
	bootph-all;
};

&uart2 {
	bootph-all;
	clock-frequency = <24000000>;
};

&emmc {
	bootph-all;
};

&sdmmc {
	bootph-all;

	/*
	 * PIO, not IDMAC. Measured on hardware 2026-07-29 with CONFIG_MMC_TRACE:
	 * every command-only step succeeds -- CMD0, CMD8, ACMD41 (OCR 0xc0ff8000),
	 * CMD2, CMD3, CMD9, CMD7 (0x700) -- and the FIRST data transfer,
	 * ACMD51 SEND_SCR, returns -110 ETIMEDOUT on all four retries. So the CMD
	 * line and the clock work and the DATA path does not. The pads are not the
	 * cause: GRF GPIO1A/B/C/D read 0/0x5000/0x5551/0x5555 at the prompt,
	 * identical to the values recorded live under Android, so CMD, CLKOUT and
	 * D0..D3 are all muxed FUNC1.
	 *
	 * rk3066a-mk808 and rk3188-radxarock -- the same dw_mshc generation as
	 * rk3026 -- both set fifo-mode on every mmc port, which forces the PIO
	 * path and bypasses the internal DMA entirely. They also cap the clock
	 * hard (4 MHz and 16 MHz).
	 *
	 * UNPROVEN: this has not run on hardware yet.
	 */
	fifo-mode;
};
