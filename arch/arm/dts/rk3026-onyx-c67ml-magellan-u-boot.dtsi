/*
 * U-Boot specific additions for the ONYX BOOX C67ML Magellan.
 *
 * Copyright (c) 2024, Mario Rugiero
 *
 * Pulls in the shared Rockchip binman image description and marks the
 * boot-essential nodes for the pre-relocation (SPL) phase.  The board DTS
 * already carries inline u-boot,dm-pre-reloc on uart2/emmc/sdmmc/i2c0; this
 * overlay adds the SoC infrastructure (cru, grf, oscillator) the early DM
 * needs before relocation.
 */

#include "rockchip-u-boot.dtsi"

&cru {
	bootph-all;
};

&grf {
	bootph-all;
};

&xin24m {
	bootph-all;
};

&uart2 {
	bootph-all;
	clock-frequency = <24000000>;
};

&emmc {
	bootph-all;
};

&sdmmc {
	bootph-all;
	/* fifo-mode is set in the canonical board dts (dts/), not here --
	 * it applies to the kernel build too, so it belongs in one place.
	 * See that file's &sdmmc node for the measurement it's based on. */
};

/*
 * timer_pre_probe() asks the CRU for PCLK_TIMER0 first and
 * rk3026_clk_get_rate() has no case for it, so without this property
 * clock_rate stays 0 and timer_post_probe() rejects the device.  A dead
 * get_timer() then makes wait_for_bit_le32() spin forever instead of timing
 * out (include/wait_bit.h:45), which hangs acm_stdio_start() -- the LED
 * rhythms still run (spin loops) but USB never enumerates.
 *
 * PROVEN on hardware 2026-07-29 (card 78, 4:1 match).  Regressed 2026-07-29
 * by f513e0e, which copied the canonical dtsi over this tree's; kept here
 * rather than in dts/ because it is a U-Boot driver workaround and because
 * this overlay is the one file no canonical sync overwrites.
 *
 * 24 MHz is device-measured (timer1 sampled 30 s apart: 24,000,665 Hz).
 * Remove once rk3026_clk_get_rate() handles PCLK_TIMER0.
 */
&{/timer@20044000} {
	clock-frequency = <24000000>;
};
