if ROCKCHIP_RK3026

choice
	prompt "RK3026 board select"

config TARGET_BOOX_C67ML
	bool "ONYX BOOX C67ML Magellan"
	select BOARD_LATE_INIT
	select RK3026_SPL_TIMER_STASH
	help
	  Support for the ONYX BOOX C67ML Magellan 6" e-reader and its
	  rebrands (DOOKU, Afterglow 2, Tagus Lux, etc).  RK3026 dual-core
	  Cortex-A9, 512 MB DDR3, 4 GB raw NAND (closed FTL, unusable by
	  mainline), microSD, E Ink display.

endchoice

config ROCKCHIP_BOOT_MODE_REG
	# GRF_OS_REG5 (GRF + 0x1dc): the register the vendor kernel uses for the
	# Linux-side boot mode (mach-rk3026/reset.c; OS_REG4 at 0x1d8 is the
	# loader-side one).  rk3036's 0x1c8 (OS_REG0) does not apply here.
	default 0x200081dc

config ROCKCHIP_STIMER_BASE
	hex
	default 0x200440a0
	help
	  Restored to the pre-session value while bisecting a regression.

	  The device dump says timers are 0x20 apart with only n=0 and n=1
	  implemented, so this address should not decode -- yet this is the value
	  that was in the tree when the SPL demonstrably ran. Do not "fix" it
	  again without a boot to show for it.

config RK3026_SPL_TIMER_STASH
	bool
	help
	  The SPL measures the A9 global timer against timer0 and leaves the
	  result in GRF_OS_REG2..4, where the C67ML board code reads it back
	  and prints it at the prompt; other boards have no reader. OS_REG4
	  is also the vendor loader's reboot-mode register, and the GRF keeps
	  it over a warm reset, so a board that may boot the vendor loader
	  next must not write it.

config SYS_SOC
	default "rk3026"

config SYS_MALLOC_F_LEN
	# 0x400 (copied from rk3036) is NOT enough for this board: pre-relocation
	# dm_init_and_scan() exhausts it and returns -ENOMEM, initf_dm propagates
	# that, the INITCALL fails and U-Boot calls hang() -- which spins with the
	# LED untouched, so it looks exactly like a lock-up rather than an error.
	# PROVEN on hardware 2026-07-28: with 0x400 the board never reaches
	# board_early_init_f; with 0x2000 it does.
	default 0x2000

config SPL_SERIAL
	default y

source "board/rockchip/boox-c67ml/Kconfig"

endif
