# U-Boot defconfig — ONYX BOOX C67ML Magellan (RK3026, dual Cortex-A9)
#
# Modeled on the in-tree evb-rk3036 A9 board (same RK292x SPL memory layout:
# SPL runs from internal SRAM at 0x10080000, not DRAM) with C67ML specifics:
# UART2 console, SD/eMMC (dwmmc) boot, ACT8931 PMIC on I2C0.
#
# Storage note: the device's internal flash is RAW NAND behind a closed FTL
# (no mainline driver), so real boot media is the microSD card via dwmmc.
#
# RK3026 is Cortex-A9: no ARM architected generic timer (CONFIG_SYS_ARCH_TIMER
# must stay off), so U-Boot proper uses the DM Rockchip timer and the SPL uses
# a local __udelay() over the same timer (rk3026-board-spl.c).

CONFIG_ARM=y
CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_SPL_SKIP_LOWLEVEL_INIT=y
# CONFIG_SYS_ARCH_TIMER is not set
CONFIG_ARCH_ROCKCHIP=y
CONFIG_TEXT_BASE=0x60000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x60100000
CONFIG_DEFAULT_DEVICE_TREE="rk3026-onyx-c67ml-magellan"
CONFIG_ROCKCHIP_RK3026=y
CONFIG_SPL_ROCKCHIP_BACK_TO_BROM=y
CONFIG_SPL_STACK_R_ADDR=0x80000
CONFIG_SPL_STACK=0x10081fff
# Payload byte 0 lands at 0x10080800, and mkimage OVERWRITES bytes 0..3 with
# the "RK30" tag, so the first linked word is sacrificial — boot0.h reserves it
# ("b 1f"). The BROM then branches to a fixed 0x10080804. Linking at 0x...804
# instead skews every absolute word by 4 and fails silently. (BROM disassembly.)
CONFIG_SPL_TEXT_BASE=0x10080800
# Minimal SPL, modeled on rk3036: a tiny board_init_f that inits the debug
# UART + timer, brings up DRAM, and returns to the mask ROM (back-to-BROM).
# The BROM never touches the DDR controller and leaves the PLLs bypassed at
# 24MHz, so sdram_init() here is what trains DRAM — hence SPL_STACK must stay
# in SRAM.  No framework / malloc / block layer is pulled in, which keeps the
# SPL small enough for internal SRAM.
# CONFIG_SPL_FRAMEWORK is not set
# Back-to-BROM: the mask ROM (not the SPL) loads U-Boot proper, so the SPL
# needs NO MMC/block/DM stack — it only inits UART+timer and returns. Keeping
# SPL_MMC off avoids dragging in malloc_simple/bounce_buffer/part_init.
# CONFIG_SPL_MMC is not set
# CONFIG_SPL_BLK is not set
# CONFIG_SPL_DM is not set
# Keep the back-to-BROM SPL tiny: no partition/blk code (those pull part_init /
# blk-uclass and the full DM malloc into SPL).  Mirrors evb-rk3036.
# CONFIG_SPL_PARTITIONS is not set
# CONFIG_SPL_DOS_PARTITION is not set
# CONFIG_SPL_EFI_PARTITION is not set
# CONFIG_SPL_USE_ARCH_MEMCPY is not set
# CONFIG_SPL_USE_ARCH_MEMSET is not set
CONFIG_SPL_LIBGENERIC_SUPPORT=y
CONFIG_SPL_SERIAL=y
CONFIG_SPL_STACK_R=y
CONFIG_SYS_LOAD_ADDR=0x60800800
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_BASE=0x20068000
CONFIG_DEBUG_UART_CLOCK=24000000
CONFIG_DEBUG_UART_SHIFT=2
CONFIG_DEBUG_UART_ANNOUNCE=y
# The raw debug-UART driver does no pinmux: board_debug_uart_init() in
# mach-rockchip/rk3026/rk3026.c muxes GPIO2_C6/C7 to UART2 (FUNC3) first.
CONFIG_DEBUG_UART_BOARD_INIT=y
CONFIG_SYS_NS16550_MEM32=y
CONFIG_CONSOLE_MUX=y
CONFIG_DEFAULT_FDT_FILE="rk3026-onyx-c67ml-magellan.dtb"
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_DISPLAY_BOARDINFO is not set
# CONFIG_DISPLAY_BOARDINFO_LATE is not set
# CONFIG_SPL_FRAMEWORK is not set
CONFIG_SPL_NO_BSS_LIMIT=y
CONFIG_SPL_HAVE_INIT_STACK=y
# Staged LED progress signal (no serial console yet): blink count = milestone,
# emitted from board_early_init_f / dram_init / misc_init_r, plus an
# EVT_LAST_STAGE_INIT spy (board_late_init is taken by mach-rockchip/board.c).
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_LAST_STAGE_INIT=y
CONFIG_MISC_INIT_R=y
CONFIG_CMD_USB=y
CONFIG_CMD_USB_MASS_STORAGE=y
# Command tables and filesystem libraries: nothing here runs before the prompt,
# and the boot does not reach a prompt yet. Re-add CONFIG_CMD_FAT ALONE once
# there is a kernel to load -- U-Boot stays FAT-only and reads the zImage from a
# FAT partition. EXT4 does not come back with it.
# CONFIG_CMD_GPT is not set
# CONFIG_CMD_I2C is not set
# CONFIG_CMD_MMC is not set
# CONFIG_CMD_FAT is not set
# CONFIG_CMD_EXT4 is not set
# CONFIG_CMD_FS_GENERIC is not set
# CONFIG_CMD_CACHE is not set
CONFIG_OF_CONTROL=y
CONFIG_ENV_IS_NOWHERE=y
CONFIG_SYSCON=y
CONFIG_REGMAP=y
CONFIG_CLK=y
# Cortex-A9 has no arch timer: use the Rockchip DM timer in U-Boot proper.
CONFIG_SYS_TIMER_COUNTS_DOWN=y
CONFIG_TIMER=y
CONFIG_ROCKCHIP_TIMER=y
CONFIG_ROCKCHIP_GPIO=y
CONFIG_PINCTRL=y
CONFIG_DM_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
# CONFIG_SPL_DM_SERIAL is not set
CONFIG_SYS_I2C_ROCKCHIP=y
CONFIG_DM_I2C=y
# CONFIG_SPL_DM_I2C is not set
CONFIG_DM_PMIC=y
# CONFIG_SPL_DM_PMIC is not set
CONFIG_PMIC_ACT8865=y
CONFIG_DM_REGULATOR=y
# CONFIG_SPL_DM_REGULATOR is not set
CONFIG_REGULATOR_ACT8865=y
CONFIG_SYSRESET=y
# CONFIG_SPL_SYSRESET is not set
CONFIG_USB=y
CONFIG_DM_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_STORAGE=y
CONFIG_SPL_TINY_MEMSET=y
# UEFI is an upstream default for armv7 (lib/efi_loader/Kconfig: "default y if
# ... SYS_CPU = armv7"), not something this board asked for. We boot a zImage
# via extlinux/distroboot, never an EFI binary. It also pulls in LMB, DM_EVENT,
# EVENT_DYNAMIC, LIB_UUID and CHARSET, adds efi_init_early + efi_memory_init to
# board_init_r, and is part of why u-boot.img grew 844 -> 936 sectors.
# CONFIG_EFI_LOADER is not set
# Both are print-only, and there is no console before the failure.
# CONFIG_ERRNO_STR is not set

# USB CDC-ACM console. The OTG controller (usb@10180000, dwc2) is the only
# bidirectional channel this board has without soldering to the UART leads.
# PRE_CONSOLE_BUFFER matters as much as the gadget itself: USB cannot enumerate
# until late in board_init_r, so without it every message from before that point
# would be lost -- which is exactly the part worth reading.
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="ONYX"
CONFIG_USB_GADGET_VENDOR_NUM=0x2207
CONFIG_USB_GADGET_PRODUCT_NUM=0x0010
CONFIG_USB_GADGET_DWC2_OTG=y
CONFIG_USB_FUNCTION_ACM=y
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_PRE_CONSOLE_BUFFER=y
CONFIG_PRE_CON_BUF_ADDR=0x60f00000
CONFIG_PRE_CON_BUF_SZ=8192
